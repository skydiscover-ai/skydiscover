# Trace data (large binary files)
*.dat
*.meta.json

# Build artifacts
interface/build/
**/build/
traces/belady/belady_sim

# Generated implementations (auto-generated by LLM)
interface/generated/kvstore_impl.cc
interface/generated/kvstore_rust/

# Experiment outputs and runtime state (large -- not tracked).
# Per-run dirs (experiments/<run_key>_<timestamp>/) hold raw iter_NNN/
# artifacts that can be regenerated from the impl source.
experiments/*
workspaces/
eval_results/
old/
archive*
archive/*

# EXCEPT: curated logs (summaries, plots, best impls for the paper).
# Re-allow the dir here, then re-allow its contents at the bottom of the
# file to override the global *.png / *.log / *.jsonl ignores further down.
!experiments/logs/

# ── Large files ──────────────────────────────────────────
# Binary / compiled objects
*.o
*.so
*.a
*.dylib
*.bin
*.exe

# Archives
*.tar
*.tar.gz
*.tar.bz2
*.zip
*.gz
*.bz2

# Data files
*.parquet
*.h5
*.hdf5
*.npy
*.npz
*.csv
*.jsonl

# ML / checkpoint files
*.pt
*.pth
*.ckpt
*.pkl
*.pickle

# Images (plots, screenshots)
*.jpg
*.jpeg
*.bmp

# Log files
*.log
agent_log.txt

# Core dumps (generic — shadows any `core` file/dir at any depth)
core
core.*

# Exceptions: vendored FASTER source trees ship a `core/` subdir that the
# `core` rule above would otherwise hide. Negate so they stay tracked.
!setups/faster-single-machine/seeds_faster/faster_src/core
!setups/faster-single-machine/seeds_faster/faster_src/core/**

# Database files
*.db
*.rdb
*.aof
dump.rdb

# PDFs
*.pdf

# Sensitive / environment files
.env
.env.*


# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
env/

# OS / editor
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# ── Whitelist: curated experiment logs ───────────────────────────────────
# These override the file-type ignores above (*.png, *.log, *.jsonl, etc.)
# for anything inside experiments/logs/ — that directory is for paper-ready
# artifacts (summaries, plots, best impls) and should be fully tracked.
!experiments/logs/**

# ── Vendored dependencies under seeds/ — override global "core" ignore. ─────
# The "core" gitignore pattern above is meant to catch Linux coredump files,
# but it also matches directories literally named "core" in third-party
# vendored trees (e.g. FASTER has a cc/src/core/ subdir we ship verbatim
# under seeds/faster/faster_src/core/). Re-allow anything under seeds/.
!seeds/**

# ── Curated example runs — override file-type ignores above ───────────
!runs/shu_example/**
